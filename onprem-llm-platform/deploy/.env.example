# 複製為 .env 後修改
# 模型路徑（離線帶入的模型目錄，掛載到容器 /models）
MODELS_DIR=/data/models
LLM_MODEL=/models/llm
LLM_SERVED_NAME=domain-llm
EMBED_MODEL=/models/embed
EMBED_SERVED_NAME=domain-embed
RERANK_MODEL=/models/rerank
RERANK_SERVED_NAME=domain-rerank

# 多節點平行設定
TENSOR_PARALLEL=8
PIPELINE_PARALLEL=2
MAX_MODEL_LEN=32768
GPU_MEM_UTIL=0.90

# 叢集網路
RAY_HEAD_IP=10.0.0.11
LLM_URL=http://10.0.0.11:8000/v1
EMBED_URL=http://10.0.0.12:8001/v1
RERANK_URL=http://10.0.0.12:8002
QDRANT_URL=http://qdrant:6333

# 映像版本（固定版本，便於離線審查）
VLLM_IMAGE=vllm/vllm-openai:latest
QDRANT_IMAGE=qdrant/qdrant:latest
